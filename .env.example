# Password untuk masuk ke aplikasi (WAJIB diisi di Vercel supaya data Anda aman)
APP_PASSWORD=ganti-dengan-password-panjang

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# "service_role" key (RAHASIA, hanya dipakai di server; jangan pakai awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
